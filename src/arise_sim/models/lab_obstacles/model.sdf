<?xml version="1.0" ?>
<!--
  Optional obstacle boxes and landmarks from the original drone world.
  Positions and sizes are unchanged. They are static here (fixed in place);
  in the original they could be pushed around. Added with obstacles:=true.
-->
<sdf version="1.9">
  <model name="lab_obstacles">
    <static>true</static>
    <link name="link">
      <collision name="box_1_collision"><pose>0 1 0.15 0 0 0</pose><geometry><box><size>1 0.1 0.3</size></box></geometry></collision>
      <visual name="box_1_visual"><pose>0 1 0.15 0 0 0</pose><geometry><box><size>1 0.1 0.3</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      <collision name="box_2_collision"><pose>0 -1 0.15 0 0 0.15</pose><geometry><box><size>1 0.1 0.3</size></box></geometry></collision>
      <visual name="box_2_visual"><pose>0 -1 0.15 0 0 0.15</pose><geometry><box><size>1 0.1 0.3</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      <collision name="box_3_collision"><pose>-1 0 0.15 0 0 0</pose><geometry><box><size>0.1 1 0.3</size></box></geometry></collision>
      <visual name="box_3_visual"><pose>-1 0 0.15 0 0 0</pose><geometry><box><size>0.1 1 0.3</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      <collision name="box_4_collision"><pose>1 2 0.15 0 0 0</pose><geometry><box><size>1 0.1 0.3</size></box></geometry></collision>
      <visual name="box_4_visual"><pose>1 2 0.15 0 0 0</pose><geometry><box><size>1 0.1 0.3</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      <collision name="landmark_1_collision"><pose>1.8 3.8 0.2 0 0 0</pose><geometry><box><size>0.1 0.1 0.4</size></box></geometry></collision>
      <visual name="landmark_1_visual"><pose>1.8 3.8 0.2 0 0 0</pose><geometry><box><size>0.1 0.1 0.4</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      <collision name="landmark_2_collision"><pose>-1.8 -3.8 0.5 0 0 0</pose><geometry><box><size>0.1 0.1 1</size></box></geometry></collision>
      <visual name="landmark_2_visual"><pose>-1.8 -3.8 0.5 0 0 0</pose><geometry><box><size>0.1 0.1 1</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      <collision name="landmark_3_collision"><pose>1.8 -3.8 0.1 0 0 0</pose><geometry><box><size>0.2 0.1 0.2</size></box></geometry></collision>
      <visual name="landmark_3_visual"><pose>1.8 -3.8 0.1 0 0 0</pose><geometry><box><size>0.2 0.1 0.2</size></box></geometry>
        <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
